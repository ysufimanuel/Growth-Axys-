rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Public read; only users with a verified admin custom claim can write.
    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /siteContent/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Contact inquiries are not written directly from this public frontend.
    // Use a trusted backend/Cloud Function if you later need private inquiry storage.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}