# ---- Public (aman di browser) ----
# Domain canonical. Ganti dengan domain resmi setelah ditentukan.
NEXT_PUBLIC_SITE_URL=https://pillarians-group.vercel.app

# Firebase Web config (bukan secret; amankan lewat Auth + Rules + pembatasan API key)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=growth-axys.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=growth-axys
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Server-only (JANGAN prefix NEXT_PUBLIC, simpan di Vercel env) ----
FIREBASE_PROJECT_ID=growth-axys
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Database Firestore bernama "default" (bukan "(default)") pada project ini
FIREBASE_DATABASE_ID=default
# UID akun Superadmin awal (kompatibel dengan versi vanilla)
SUPER_ADMIN_UID=
